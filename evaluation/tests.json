            "matched_count": {"exact": 1},
            "result_ids": [48],
            "result_constraints": {
              "fuel": "Diesel",
              "body_type": "mini truck",
              "city": "Mumbai",
              "max_price": 500000
            },
            "selected_vehicle": null,
            "spoken": {
              "contains": ["Ace Gold", "₹1.2 lakh", "173,368 km"],
              "grounded": true
            }
          }
        }
      ]
    },
    {
